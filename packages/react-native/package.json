{
  "name": "@algosoftltd/algo-widget-react-native",
  "version": "0.1.1",
  "description": "Algo Widget for React Native — in-app bug reporting with screen, voice and a recorded interaction trace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algosoftbd/algo-widget-mobile.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/algosoftbd/algo-widget-mobile#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "bug-report",
    "feedback",
    "crash-reporting",
    "algosoft"
  ],
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.70",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./panel": {
      "types": "./lib/panel.d.ts",
      "default": "./lib/panel.js"
    }
  },
  "peerDependenciesMeta": {
    "react-native-webview": {
      "optional": true
    }
  }
}
