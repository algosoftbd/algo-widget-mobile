# Build output only. NOT a bare `lib/` — that is the TypeScript package's build
# directory AND the Flutter package's SOURCE directory, and the broad pattern
# silently excluded every Dart file in the repository.
packages/react-native/lib/
node_modules/

.dart_tool/
# Regenerated by `flutter pub get`, and it holds ABSOLUTE pub-cache paths from
# whoever ran it — its own first field says not to check it in. Tracked once,
# which made every `flutter test` dirty the tree on every machine.
.flutter-plugins-dependencies
pubspec.lock

build/
.gradle/
local.properties
.build/
*.xcuserstate
xcuserdata/

*.log
.DS_Store
